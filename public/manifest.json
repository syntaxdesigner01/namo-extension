{
    "manifest_version": 3,
    "name": "Namo AI",
    "version": "0.0.1",
    "description": "AI-powered browser companion extension",
    "action": {
        "default_popup": "popup.html"
    },
    "permissions": [
        "storage",
        "tabs"
    ],
    "background": {
        "service_worker": "background.js"
    }
}