{
    "manifest_version": 3,
    "name": "Namo AI",
    "version": "0.0.1",
    "description": "AI-powered browser companion extension",
    "action": {
        "default_popup": "/src/popup.html"
    },
    "permissions": [
        "storage",
        "tabs",
        "offscreen",
        "tts",
        "scripting",
        "activeTab"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "host_permissions": [
        "https://open.spotify.com/*"
    ]
}
